{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main and minimap windows",
  "windows": ["main", "minimap"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "dialog:default",
    "opener:default",
    "log:default",
    "updater:default",
    "process:allow-restart"
  ]
}
